doctype html
html(lang="en")
    head
        title weathericon
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
        link(rel="stylesheet" href="../weather.css" crossorigin="anonymous")
    body
        div(class="icontext" id="weathertext")
        div(class="icon sunny" id="sunny")
            div(class="sun")
                div(class="rays")
        div(class="icon few-clouds" id="fewclouds")
            div(class="icontext" id="fewcloudstext")
            div(class="cloud")
            div(class="sun")
                div(class="rays")
        div(class="icon cloudy" id="cloudy")
            div(class="cloud")
            div(class="cloud")
        div(class="icon drizzle" id="drizzle")
            div(class="cloud")
            div(class="sun")
                div(class="rays")
            div(class="rain")
        div(class="icon rainy" id="rainy")
            div(class="cloud")
            div(class="rain")
        div(class="icon thunder-storm" id="thunderstorm")
            div(class="cloud")
            div(class="lightning")
                div(class="bolt")
                div(class="bolt")
        div(class="icon flurries" id="flurries")
            div(class="cloud")
            div(class="snow")
                div(class="flake")
                div(class="flake")
        div(class="icon atmo" id="atmo")
            div(class="cloud")
                div(class="bolt")
            div(class="sun")
                div(class="flake")
                div(class="flake")
        script(type="text/javascript" src="../weather.js" crossorigin="anonymous")